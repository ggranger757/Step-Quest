{
  "name": "stepquest-push",
  "version": "1.0.0",
  "private": true,
  "description": "Step Quest server: push notifications (mission reminders, the daily reminder) and leaderboards.",
  "type": "module",
  "scripts": {
    "keys": "node scripts/gen-vapid.mjs",
    "db:create": "wrangler d1 create stepquest-push",
    "db:schema": "wrangler d1 execute stepquest-push --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "test": "node --test test/push.test.mjs test/leaderboard.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
